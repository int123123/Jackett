menu "ESP Person Counter"

config PERSON_COUNTER_FRAME_SIZE
    string "Camera frame size"
    default "QVGA"
    help
        Camera frame size used for capture and preprocessing.
        Options: QQVGA, QVGA, VGA, SVGA, XGA, SXGA, UXGA

config PERSON_COUNTER_YOLO_INPUT_SIZE
    int "YOLO input size (square)"
    range 128 416
    default 320

config PERSON_COUNTER_SCORE_THRESHOLD
    int "Detection score threshold (percent)"
    range 1 99
    default 40

config PERSON_COUNTER_NMS_IOU
    int "NMS IoU threshold (percent)"
    range 10 90
    default 50

menu "Camera Pins"

config CAM_PIN_PWDN
    int "PWDN GPIO"
    default -1
config CAM_PIN_RESET
    int "RESET GPIO"
    default -1
config CAM_PIN_XCLK
    int "XCLK GPIO"
    default 10
config CAM_PIN_SIOD
    int "SIOD GPIO (SDA)"
    default 4
config CAM_PIN_SIOC
    int "SIOC GPIO (SCL)"
    default 5
config CAM_PIN_D7
    int "D7 GPIO"
    default 16
config CAM_PIN_D6
    int "D6 GPIO"
    default 15
config CAM_PIN_D5
    int "D5 GPIO"
    default 7
config CAM_PIN_D4
    int "D4 GPIO"
    default 6
config CAM_PIN_D3
    int "D3 GPIO"
    default 13
config CAM_PIN_D2
    int "D2 GPIO"
    default 12
config CAM_PIN_D1
    int "D1 GPIO"
    default 11
config CAM_PIN_D0
    int "D0 GPIO"
    default 9
config CAM_PIN_VSYNC
    int "VSYNC GPIO"
    default 8
config CAM_PIN_HREF
    int "HREF GPIO"
    default 18
config CAM_PIN_PCLK
    int "PCLK GPIO"
    default 17

endmenu

endmenu
